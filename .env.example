# GB Chat — environment variables (sample)
# Local chalane ke liye is file ko ".env" naam se copy karein.
# Render par ye values dashboard/Blueprint me jaati hain — file ki zaroorat nahi.

# Neon Postgres connection string (https://neon.com -> project -> connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Socket settings (Render par render.yaml already set karta hai — local me chahiye to uncomment)
# NEXT_PUBLIC_SOCKET_URL=/
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
